    "preview",
    "resume",
    "background",
    "skip_preflight"
  ],
  "actions": {
    "init": {
      "entry": "run",
      "required": [
        "fastq",
        "outdir",
        "species",
        "assay"
      ],
      "optional": [
        "init"
      ],
      "force": [
        "init"
      ]
    },
    "preview": {
      "entry": "run",
      "required": [
        "fastq",
        "outdir",
        "species",
        "assay"
      ],
      "optional": [
        "preview"
      ],
      "force": [
        "preview"
      ]
    },
    "run": {
      "entry": "run",
      "required": [
        "fastq",
        "outdir",
        "species",
        "assay"
      ],
      "optional": [
        "profile",
        "resume",
        "background",
        "max_cpus",
        "max_mem",
        "reference_bundle"
      ]
    },
    "downstream": {
      "entry": "downstream",
      "required": [
        "results",
        "species"
      ],
      "optional": [
        "threads",
        "peak_jobs",
        "tier",
        "resume"
      ]
    }
  }
}
