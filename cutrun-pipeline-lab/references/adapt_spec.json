  ],
  "entrypoints": {
    "run": "bash pipelines/chipseq_auto_nf/run_auto_chipseq.sh",
    "downstream": "bash pipelines/chipseq_auto_nf/run_downstream.sh"
  },
  "roles": {
    "fastq": [
      "--fastq-dir",
      "--input-dir",
      "--fastq"
    ],
    "outdir": [
      "--outdir",
      "--output-dir",
      "--results-dir"
    ],
    "results": [
      "--results-dir",
      "--outdir",
      "--output-dir"
    ],
    "species": [
      "--species",
      "--genome"
    ],
    "assay": [
      "--assay"
    ],
    "profile": [
      "--profile"
    ],
    "threads": [
      "--threads"
    ],
    "peak_jobs": [
      "--peak-jobs"
    ],
    "tier": [
      "--resource-tier"
    ],
    "max_cpus": [
      "--max-cpus",
      "--cpus"
    ],
    "max_mem": [
      "--max-memory",
      "--memory"
    ],
    "init": [
      "--init-only",
      "--init"
    ],
    "preview": [
      "--preview"
    ],
    "resume": [
      "--resume"
    ],
    "background": [
      "--background"
    ],
    "skip_preflight": [
      "--skip-preflight"
    ],
    "reference_bundle": [
      "--reference-bundle"
    ]
  },
  "booleans": [
